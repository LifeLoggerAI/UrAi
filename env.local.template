# Legacy repository local source-verification template.
# `LifeLoggerAI/UrAi` is not current production authority and must never deploy.

# Public values (NEXT_PUBLIC_* are sent to the browser)
NEXT_PUBLIC_APP_NAME=UrAi
NEXT_PUBLIC_ENV=local

# Firebase web/client configuration may be supplied only for non-authoritative local UI checks.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional local development API value. Never commit a populated .env.local file.
OPENAI_API_KEY=

# Local/demo-only admin status header gate.
# Keep unset or 0. This legacy repository has no production admin authority.
URAI_ENABLE_HEADER_ADMIN_STATUS=0

# Provider identity / deployment credentials are intentionally absent.
# Do not add FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY, FIREBASE_SERVICE_ACCOUNT_KEY,
# raw service-account JSON, credentials_json, or FIREBASE_TOKEN here.
# Any current provider work belongs to the canonical governed system and must use
# short-lived ADC/WIF under its own exact-head release authority.
